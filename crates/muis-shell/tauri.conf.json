{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "muis",
  "version": "1.0.0",
  "identifier": "org.veldmuislinux.muis",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "muis",
        "width": 1100,
        "height": 700,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "../../data/icons/hicolor/48x48/apps/muis.png",
      "../../data/icons/hicolor/64x64/apps/muis.png",
      "../../data/icons/hicolor/128x128/apps/muis.png",
      "../../data/icons/hicolor/256x256/apps/muis.png",
      "../../data/icons/hicolor/512x512/apps/muis.png"
    ],
    "category": "Utility",
    "shortDescription": "muis terminal for Veldmuis",
    "linux": {
      "deb": {},
      "appimage": {
        "files": {
          "usr/bin/muis-worker": "../../target/release/muis-worker",
          "usr/bin/muis-notify": "../../target/release/muis-notify"
        }
      }
    },
    "windows": {}
  }
}
